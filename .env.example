# Required when LLM_MOCK=false: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: DhanHQ access token (JWT, valid 24 h) for live NSE market data.
# Needs the Dhan Data API plan. The client ID is read from the token.
# Leave empty to use the built-in market simulator.
DHAN_ACESS_TOKEN=

# Optional: overrides the client ID inside the token
# DHAN_CLIENT_ID=

# Optional: integer seed that makes the simulator reproducible
# MARKET_SEED=

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
